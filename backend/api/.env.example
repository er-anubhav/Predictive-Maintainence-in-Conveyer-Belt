# Application Settings
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL Database Configuration
# Default docker-compose maps container 5432 to host port 5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/sih_db

# For testing with SQLite fallback if needed
# TEST_DATABASE_URL=sqlite:///:memory:
